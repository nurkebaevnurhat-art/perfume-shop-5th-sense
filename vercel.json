{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/export-site.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/orders.js": {
      "includeFiles": "assets/js/*.js",
      "maxDuration": 15
    },
    "api/telegram.js": {
      "includeFiles": "assets/js/*.js",
      "maxDuration": 15
    },
    "api/bot.js": {
      "includeFiles": "assets/js/*.js",
      "maxDuration": 15
    },
    "api/products.js": {
      "includeFiles": "assets/js/*.js",
      "maxDuration": 30
    },
    "api/image.js": {
      "includeFiles": "assets/js/*.js",
      "maxDuration": 30
    },
    "api/page.js": {
      "includeFiles": "{index.html,assets/js/*.js}",
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "includeFiles": "assets/js/*.js",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/sitemap?robots=1"
    },
    {
      "source": "/:p(catalog|catalog-[a-z]+|family-[a-z]+|brands|brand-[a-z0-9-]+|product-[a-z0-9-]+|delivery|gifts|terms|privacy|returns)",
      "destination": "/api/page?p=:p"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(manifest|kassa).webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/api/((?!products|image).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
